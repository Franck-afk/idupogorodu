# =============================================================================
# Репозиторий проекта «Иду по городу» (idupogorodu) — DEV-53.
#
# Стратегия: монолит. Один репозиторий в корне wp-content, в него попадают
# ТОЛЬКО наши артефакты и документация:
#
#   plugins/idpg-core/          плагин: бизнес-логика
#   plugins/idpg-auth/          плагин: соцвход (wp-auth-ru)
#   plugins/idpg-event-import/  плагин: импорт событий (CLI, admin, провайдеры)
#   plugins/wp-cloud-sync/      плагин: синхронизация с облаком
#   themes/idpg_core/           родительская тема
#   themes/idpg_core-child/     дочерняя тема
#   docs/                       документация проекта
#   .circleci/  .github/        конфигурация CI
#   AGENTS.md  package.json  index.php
#
# Всё остальное — стороннее, генерируемое, приватное или слишком тяжёлое.
# Сторонние плагины и темы ставит администратор сайта, зависимости —
# `composer install` / `npm install`, контент и бэкапы живут только на сервере.
#
# ИСКЛЮЧЕНИЕ (DEV-60): вендорные ФРОНТЕНД-ассеты наших плагина и темы лежат
# в каталогах `assets/*/vendor/` и НАМЕРЕННО tracked. Они не восстанавливаются
# ни composer, ни npm — после чистого клона фронтенд остался бы без них.
# Точечные `!`-правила — в блоке «Зависимости»; сторонние плагины это не
# открывает (проверено: `wp-mail-smtp/vendor/` остаётся IGNORED).
# =============================================================================

# -----------------------------------------------------------------------------
# WordPress: пользовательский контент и приватное
# -----------------------------------------------------------------------------
# Загрузки пользователей: ~34 МБ, меняются каждый день, не воспроизводимы из кода.
/uploads/
# Языковые пакеты ядра WP (не наши; переводы плагина/темы лежат внутри их каталогов).
/languages/
# Конфиг с солями и доступами к БД. На прод копируется отдельно (deploy.sh его исключает).
/wp-config*.php

# -----------------------------------------------------------------------------
# Бэкапы, дампы, служебные каталоги WordPress
# -----------------------------------------------------------------------------
/backups/
/aiowps_backups/
/wpvividbackups/
/wpvivid_uploads/
/wpvivid_staging/
/upgrade/
/upgrade-temp-backup/
/cache/
*.sql
*.sql.gz
*.bak
*.orig

# -----------------------------------------------------------------------------
# Зависимости — восстанавливаются командами, в репозитории не нужны
# -----------------------------------------------------------------------------
# composer install (в idpg-core это Carbon Fields, ~14 МБ).
vendor/
# --- Исключение DEV-60: вендорные фронтенд-ассеты (точечно, только свои) ------
# Правило `vendor/` выше матчит каталог на ЛЮБОЙ глубине, поэтому под него
# попадали и наши ассеты в `assets/*/vendor/` — они выпадали из репозитория,
# хотя были в origin/main. Эти файлы не ставятся ни composer, ни npm:
#   plugins/idpg-core/assets/vendor/{iconify,tom-select}
#   themes/idpg_core/assets/{css,js}/vendor/{toastify,xlsx}
# Всего 6 файлов, ~1 МБ. Re-include нужен, чтобы они переживали удаление
# и повторный `git add` (tracked-файлы git не игнорирует, но при потере
# из индекса вернуть их без `-f` было бы нельзя).
!plugins/idpg-core/assets/vendor/
!plugins/idpg-core/assets/vendor/**
!themes/idpg_core/assets/css/vendor/
!themes/idpg_core/assets/css/vendor/**
!themes/idpg_core/assets/js/vendor/
!themes/idpg_core/assets/js/vendor/**
# Композерные зависимости idpg-core (`plugins/idpg-core/vendor/`, ~38 МБ)
# закрыты отдельным `.gitignore` внутри плагина и остаются IGNORED.
# npm install для сборки SCSS темы.
node_modules/
# Артефакты прогонов PHPUnit.
.phpunit.result.cache
.phpunit.cache/

# -----------------------------------------------------------------------------
# Сторонние плагины и темы: default-deny, разрешаем только наши
# -----------------------------------------------------------------------------
# Любой новый сторонний плагин/тема автоматически игнорируются — их не нужно
# вручную добавлять в этот файл.
#
# ВАЖНО (исправлено после DEV-53): здесь перечислены ВСЕ наши плагины. В первой
# редакции были только idpg-core и idpg-auth, из-за чего собственные плагины
# idpg-event-import и wp-cloud-sync молча выпали из репозитория, хотя лежали
# в ветке main. При добавлении нового своего плагина — обязательно re-include.
/plugins/*
!/plugins/idpg-core/
!/plugins/idpg-auth/
!/plugins/idpg-event-import/
!/plugins/wp-cloud-sync/
# Заглушка WP, запрещающая листинг каталога.
!/plugins/index.php

/themes/*
!/themes/idpg_core/
!/themes/idpg_core-child/
!/themes/index.php

# mu-plugins: штатных нет. Здесь же появляются ВРЕМЕННЫЕ mu-plugin из рецептов
# тестирования (авто-логин в админку — фактически бэкдор), поэтому каталог
# закрыт целиком. Если появится штатный mu-plugin, добавьте точечное исключение.
/mu-plugins/

# -----------------------------------------------------------------------------
# Отладка и логи
# -----------------------------------------------------------------------------
*.log
debug.log
debug-*.log
php_errors.log

# -----------------------------------------------------------------------------
# Инструменты разработчика
# -----------------------------------------------------------------------------
# Локальная обвязка PHPCS (PHPCS + WPCS + forrest79/phpcs-ignores) — не часть проекта.
/phpcs-tools/
/phpcs-tools2/
# Рабочие данные ассистента (скиллы, журналы, служебное).
# MEMORY.md исключён из игнора намеренно: это память проекта
# (правила, грабли, рецепты), она нужна в репозитории и без git
# её не восстановить. Остальное содержимое каталога — локальное.
.workbuddy-ai/*
!.workbuddy-ai/MEMORY.md

# -----------------------------------------------------------------------------
# IDE и ОС
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.iml
*.swp
*.swo
.DS_Store
Thumbs.db

# -----------------------------------------------------------------------------
# Окружение и временные файлы
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.tmp
*.temp
.cache/

# Временные скрипты в корне (не путать с plugins/*/tests/test-*.php).
/test_*.php
/tmp-*.php
/audit-*.php
/fix_*.php
