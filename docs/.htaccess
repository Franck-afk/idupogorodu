# Внутренняя документация проекта. На runtime не влияет: ни один файл
# отсюда не подключается WordPress'ом. Закрыт, потому что бэклоги содержат
# перечень известных пробелов и незакрытых задач, а выгрузка Carbon Fields —
# внутреннюю структуру полей.
<IfModule mod_authz_core.c>
	Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
	Order deny,allow
	Deny from all
</IfModule>
