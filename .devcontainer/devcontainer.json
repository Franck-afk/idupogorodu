{
  "name": "WordPress Dev (Иду по городу)",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "wordpress",
  "workspaceFolder": "/var/www/html",
  "forwardPorts": [8080, 3306],
  "portsAttributes": {
    "8080": {
      "label": "WordPress",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "echo 'WordPress environment ready. Visit the forwarded port.'",
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "xdebug.php-debug"
      ]
    }
  }
}
